# SEC EDGAR requires a descriptive User-Agent with a contact email.
# See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="stock-metrics your.name@example.com"

# Optional: where the local SQLite cache lives (default: data/stock_metrics.db)
# STOCK_METRICS_DB=data/stock_metrics.db

# Days before cached company data is refreshed (default: 7)
# STOCK_METRICS_CACHE_DAYS=7
